{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SmartPress",
  "version": "../package.json",
  "identifier": "cloud.namka.smartpress",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "NEXT_PUBLIC_TARGET=desktop npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SmartPress",
        "width": 1120,
        "height": 740,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0C0E12",
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
